# Port, na ktorom bude aplikácia dostupná na serveri
PORT=3000

# Google OAuth Client ID (typ "Web application") – bez neho sa nikto neprihlási
GOOGLE_CLIENT_ID=

# Povolené domény e-mailov oddelené čiarkou; prázdne = hocijaký Google účet
ALLOWED_DOMAINS=trojsten.sk

# Heslo do databázy (stačí zmeniť pred prvým spustením)
POSTGRES_PASSWORD=zmen-ma

# Secure cookie: auto = podľa HTTPS (aj za reverse proxy), 1 = vždy, 0 = nikdy
COOKIE_SECURE=auto

# Len na lokálne testovanie: prihlásenie bez Google zadaním e-mailu. Na verejnom serveri nechaj 0!
DEV_LOGIN=0

# Tajný kľúč pre scripts/deploy.sh (oznámenie reštartu online ľuďom); prázdne = oznamuje sa len z admin panelu
DEPLOY_TOKEN=
