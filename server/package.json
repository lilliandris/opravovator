{
  "name": "@opravovator/server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@opravovator/shared=../shared/src --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@opravovator/shared": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "archiver": "^8.0.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.3",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
